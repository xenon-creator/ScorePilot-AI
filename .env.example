# =========================================================================
# AegisGrading AI: Local Environment Variables Configuration Template
# =========================================================================

# App Core Configuration
PROJECT_NAME="AegisGrading AI"
API_V1_STR="/api/v1"
JWT_SECRET="super-secret-aegis-grading-key-2026"

# Relational PostgreSQL Database Variables
DB_HOST="localhost"
DB_USER="postgres"
DB_PASSWORD="postgres"
DB_NAME="aegis_grading"

# Asynchronous Broker Cache
REDIS_URL="redis://localhost:6379/0"

# Object Storage S3 MinIO Configurations
S3_ENDPOINT="localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="exam-papers"

# AI Threshold parameters
AI_CONFIDENCE_THRESHOLD=0.85

# Sentence-Transformers Model Cache
MODEL_CACHE_DIR=./models

# OCR Configurations
# GOOGLE_APPLICATION_CREDENTIALS="path/to/credentials.json"
# TESSERACT_CMD_PATH="C:\\Program Files\\Tesseract-OCR\\tesseract.exe"

# Score Release Email (SMTP) Configurations
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=ScorePilot AI <noreply@scorepilot.ai>
STUDENT_PORTAL_URL="http://localhost:3000"

# Multi-language OCR Configurations
TESSERACT_LANGS=eng+hin

# LMS configurations
LMS_URL=http://localhost:8000/api/v1/lms/push
LMS_TOKEN=mock_token

